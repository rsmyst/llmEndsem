flowchart LR
    Action["Tool Action<br/>(Resource Access)"] --> Check{"Access<br/>Type?"}

    Check -- "Read" --> Fresh["FRESH State<br/>(Weight = 1.0)"]

    Check -- "Write" --> Mutate["Version Bump<br/>(v_new = v + 1)"]
    
    Mutate --> Sup["SUPERSEDED<br/>Prior Writers (Weight = 0)"]
    Mutate --> Stale["STALE<br/>Prior Readers (Attenuated)"]
    
    Sup & Stale --> BFS["Transitive BFS<br/>Downstream SUSPECT"]
    
    BFS -. "Re-execution" .-> Fresh
