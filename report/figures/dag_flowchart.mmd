flowchart TD
    Start(["Tool Execution"]) --> Extract["Resource Access<br/>(db, file, api, git)"]
    Extract --> Check{"Access Type?"}

    Check -- "Read" --> BindRead["Bind to Version v_curr<br/>Status: FRESH (W = 1.0)"]
    BindRead --> Done(["Done: Fresh State"])

    Check -- "Write" --> Incr["Increment Version<br/>v_new = v_curr + 1"]
    Incr --> Super["Prior Writers<br/>Mark SUPERSEDED (W = 0.0)"]
    Incr --> Stale["Prior Readers<br/>Mark STALE (Attenuated)"]

    Super & Stale --> BFS["Transitive BFS Propagation<br/>Mark Consumers SUSPECT"]
    BFS --> Truth["Truth Maintenance<br/>Re-execution Heals Path"]
    Truth --> Done
