flowchart LR
    subgraph S1 ["1. Agent & MCP Router"]
        Host["Agent Host<br/>(LLM Client)"]
        Router["MCP Router<br/>(stdio JSON-RPC)"]
        Host <-->|"Tool Calls & Feedback"| Router
    end

    subgraph S2 ["2. Ingest & Distillation"]
        Distill["Trajectory Distiller<br/>(Fact Triples)"]
        Embed["Local Vectorizer<br/>(Subword Embeddings)"]
        Router --> Distill
        Distill --> Embed
    end

    subgraph S3 ["3. Causal Storage (SQLite)"]
        DAG["Causal DAG Engine<br/>(State Invalidation)"]
        DB[("SQLite Storage<br/>(ACID Durability)")]
        Distill --> DAG
        DAG <--> DB
        Embed --> DB
    end

    subgraph S4 ["4. Retrieval & Policy"]
        Retrieval["Temporal Retrieval<br/>(Decay & Invalidation Filter)"]
        Policy["Tool Policy & Macros<br/>(Rankings & Auto-Fix)"]
        DB --> Retrieval
        DB --> Policy
        Retrieval -->|"Active Context"| Router
        Policy -->|"Policy Guidance"| Router
    end
