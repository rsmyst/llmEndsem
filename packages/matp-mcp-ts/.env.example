# ── MATP MCP — Environment Variables ────────────────────────────────────────
#
# Copy to .env and fill in as needed. None of these are required for local use
# (the server runs fully offline with defaults).

# ── Embedding backend ────────────────────────────────────────────────────────
# Options: local (default, offline/deterministic) | ollama | openai
EMBED_BACKEND=local

# ── Ollama (local, free — better semantics than "local") ────────────────────
# Requires: ollama serve + ollama pull nomic-embed-text
# EMBED_BACKEND=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text

# ── OpenAI-compatible ────────────────────────────────────────────────────────
# EMBED_BACKEND=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBED_MODEL=text-embedding-3-small

# ── Data directory ───────────────────────────────────────────────────────────
# Where the memory buffer JSON lives. Defaults to ./data (relative to cwd).
# MATP_DATA_DIR=./data

